<controls:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Checkmk.App.Controls"
        xmlns:vm="using:Checkmk.App.ViewModels"
        xmlns:models="using:Checkmk.Core.Models"
        x:Class="Checkmk.App.Views.HostDetailWindow"
        x:DataType="vm:HostDetailViewModel"
        Width="1000" Height="640"
        MinWidth="720" MinHeight="480"
        Title="Host-Details"
        Classes.viewer="{Binding !CanWrite}"
        WindowStartupLocation="CenterOwner">

  <!-- Der ✕-Button an jedem Kommentar steckt in einem ItemTemplate, dessen
       DataContext der Kommentar ist — CanWrite ist von dort nicht direkt
       bindbar. Deshalb haengt die Sichtbarkeit an einer Klasse am Fenster. -->
  <controls:ChromeWindow.Styles>
    <!-- :is(Window) ist Pflicht — ein blosses "Window" matcht in Avalonia nur den
         exakten Typ, nicht die Ableitung ChromeWindow/HostDetailWindow. -->
    <Style Selector=":is(Window).viewer Button.delete-comment">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </controls:ChromeWindow.Styles>

  <Border BorderBrush="#3A3A3A" BorderThickness="1" Background="#1E1E1E">
    <Grid RowDefinitions="40,Auto,Auto,*,Auto,Auto">

      <controls:TitleBar Grid.Row="0" Title="{Binding HostName, StringFormat='Host-Details: {0}'}" />

      <!-- Host-Kopf: State + Attribute -->
      <Border Grid.Row="1" Background="#252526" CornerRadius="6" Margin="8" Padding="14">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="9"
                    Background="{Binding HostStatus.HostState, Converter={StaticResource StateToBrush}, FallbackValue=#616161}"
                    VerticalAlignment="Center" />
            <TextBlock Text="{Binding HostStatus.HostState, FallbackValue=?}" FontSize="18"
                       FontWeight="SemiBold" VerticalAlignment="Center" />

            <!-- In Wartung: sichtbar, wenn der Host eine (Host-)Downtime hat -->
            <Border Background="#EF6C00" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                    IsVisible="{Binding HostStatus.InDowntime, FallbackValue=False}">
              <TextBlock Text="🕓 In Wartung" FontSize="12" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </Border>
            <!-- Acknowledged: sichtbar, wenn das Host-Problem quittiert ist -->
            <Border Background="#6A5ACD" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                    IsVisible="{Binding HostStatus.IsAcknowledged, FallbackValue=False}">
              <TextBlock Text="✔ Acknowledged" FontSize="12" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </Border>
          </StackPanel>

          <Grid Grid.Column="1" Margin="20,0,0,0"
                ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="10" RowSpacing="2">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ordner" Foreground="#888" FontSize="11" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HostConfig.Extensions.Folder, FallbackValue=—}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="IP" Foreground="#888" FontSize="11" />
            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding DisplayIp}" />
              <TextBlock Text="{Binding IpNote}" Foreground="#888" FontSize="11"
                         VerticalAlignment="Center" IsVisible="{Binding IpNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Alias" Foreground="#888" FontSize="11" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HostConfig.Extensions.Attributes.Alias, FallbackValue=—}" />
            <!-- Hier stand einmal „Ack: False" — ein roher Wahrheitswert, noch
                 dazu englisch, und überflüssig: Ob quittiert ist, sagt das
                 Abzeichen oben. Fehlt es, ist nichts quittiert. Aufgefallen
                 erst auf dem ersten Doku-Bild. -->

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ausgabe" Foreground="#888" FontSize="11" />
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                       Text="{Binding HostStatus.PluginOutput, FallbackValue=—}"
                       TextWrapping="Wrap" />
          </Grid>

          <!-- CanWrite ist im Viewer-Modus false (siehe HostDetailViewModel). -->
          <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="4" VerticalAlignment="Center">
            <Button Content="Host-Ack…" Click="OnHostAckClick" IsVisible="{Binding CanWrite}" />
            <Button Content="Host-Downtime…" Click="OnHostDowntimeClick" IsVisible="{Binding CanWrite}" />
            <Button Content="Host-Kommentar…" Click="OnHostCommentClick" IsVisible="{Binding CanWrite}" />
            <Button Content="Im Web öffnen" Click="OnOpenHostInWebClick" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Service-Aggregate + Aktionen -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="14"
            Margin="14,0,14,8">
        <TextBlock Grid.Column="0" Text="{Binding ServicesOk, StringFormat='OK: {0}'}"
                   Foreground="#66BB6A" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding ServicesWarn, StringFormat='WARN: {0}'}"
                   Foreground="#FFCA28" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding ServicesCrit, StringFormat='CRIT: {0}'}"
                   Foreground="#EF5350" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding ServicesUnknown, StringFormat='UNK: {0}'}"
                   Foreground="#AAAAAA" VerticalAlignment="Center" />
        <Button Grid.Column="5" Content="Ack…" Click="OnServiceAckClick"
                IsVisible="{Binding CanWrite}"
                IsEnabled="{Binding SelectedService, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Grid.Column="6" Content="Downtime…" Click="OnServiceDowntimeClick"
                IsVisible="{Binding CanWrite}"
                IsEnabled="{Binding SelectedService, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Grid.Column="7" Content="Kommentar…" Click="OnServiceCommentClick"
                IsVisible="{Binding CanWrite}"
                IsEnabled="{Binding SelectedService, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Grid.Column="8" Content="Aktualisieren" Command="{Binding RefreshCommand}"
                IsEnabled="{Binding !IsBusy}" />
      </Grid>

      <!-- Service-Tabelle -->
      <DataGrid Name="ServiceGrid" Grid.Row="3" ItemsSource="{Binding Services}"
                SelectedItem="{Binding SelectedService}"
                IsReadOnly="True" GridLinesVisibility="Horizontal" Margin="8,0,8,0"
                CanUserResizeColumns="True" CanUserSortColumns="True"
                SelectionMode="Extended">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Acknowledge…" Click="OnServiceAckClick" IsVisible="{Binding CanWrite}" />
            <MenuItem Header="Downtime…" Click="OnServiceDowntimeClick" IsVisible="{Binding CanWrite}" />
            <MenuItem Header="Kommentar…" Click="OnServiceCommentClick" IsVisible="{Binding CanWrite}" />
            <Separator IsVisible="{Binding CanWrite}" />
            <MenuItem Header="Im Checkmk-Web öffnen" Click="OnOpenServiceInWebClick" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="34">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="models:ServiceStatus">
                <Border Width="14" Height="14" CornerRadius="7"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{Binding ServiceState, Converter={StaticResource StateToBrush}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Header="Service" Binding="{Binding Description}" Width="260" />
          <DataGridTextColumn Header="Status" Binding="{Binding ServiceState}" Width="90" />
          <DataGridTextColumn Header="Ausgabe" Binding="{Binding PluginOutput}" Width="*" />
          <!-- 66 statt 50: Bei 50 px blieb vom Kopf „Ack" ein „A" uebrig (Sortierdreieck + Polsterung). -->
          <DataGridCheckBoxColumn Header="Ack" Binding="{Binding IsAcknowledged}" Width="66" />
          <DataGridCheckBoxColumn Header="DT" Binding="{Binding InDowntime}" Width="66" />
          <DataGridTextColumn Header="Letzter Check"
                              Binding="{Binding LastCheck, StringFormat='{}{0:HH:mm:ss}'}" Width="110" />
        </DataGrid.Columns>
      </DataGrid>

      <!-- Kommentare -->
      <Border Grid.Row="4" Background="#252526" CornerRadius="6" Margin="8,6,8,4" Padding="10,6">
        <Grid RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Foreground="#888888" FontSize="11" Margin="0,0,0,4"
                     Text="{Binding Comments.Count, StringFormat='Kommentare ({0})'}" />
          <ScrollViewer Grid.Row="1" MaxHeight="140" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Comments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:CompileBindings="False">
                  <Grid ColumnDefinitions="180,*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Extensions.ServiceDescription, FallbackValue='(Host)'}"
                               Foreground="#123E6B" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Extensions.Comment}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding Extensions.Author}" Foreground="#AAAAAA" FontSize="11" />
                      <TextBlock Text="{Binding Extensions.EntryTime, StringFormat='{}{0:dd.MM. HH:mm}'}"
                                 Foreground="#888888" FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="3" Content="✕" Tag="{Binding Id}"
                            Classes="delete-comment"
                            Click="OnDeleteCommentClick"
                            Padding="6,2" MinWidth="0" FontSize="11"
                            Background="#3A2323" Foreground="#EF9A9A"
                            ToolTip.Tip="Kommentar löschen" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Statusleiste -->
      <Border Grid.Row="5" Background="#123E6B">
        <TextBlock Text="{Binding StatusMessage}" Margin="10,4" FontSize="12"
                   TextTrimming="CharacterEllipsis" />
      </Border>
    </Grid>
  </Border>
</controls:ChromeWindow>
