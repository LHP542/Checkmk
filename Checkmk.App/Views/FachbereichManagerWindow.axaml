<controls:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Checkmk.App.Controls"
        xmlns:data="using:Checkmk.Data"
        x:Class="Checkmk.App.Views.FachbereichManagerWindow"
        Width="640" Height="420"
        Title="Fachbereiche verwalten"
        WindowStartupLocation="CenterOwner">

  <Border BorderBrush="#3A3A3A" BorderThickness="1" Background="#1E1E1E">
    <Grid RowDefinitions="40,Auto,*,Auto">

      <controls:TitleBar Grid.Row="0" Title="Fachbereiche verwalten" />

      <TextBlock Grid.Row="1" Margin="16,12,16,0" Foreground="#AAAAAA"
                 FontSize="12" TextWrapping="Wrap"
                 Text="Ein Fachbereich ordnet den Filter-Katalog — er entscheidet nicht, wer etwas sehen darf. Veröffentlichen darf jeder, abonnieren auch. Mitgliederlisten gibt es hier bewusst nicht." />

      <Grid Grid.Row="2" ColumnDefinitions="240,*" Margin="16,12,16,0" ColumnSpacing="12">

        <Grid Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="6">
          <ListBox Grid.Row="0" Name="FachbereichList">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="data:FachbereichRow">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
            <Button Content="Neu" Click="OnNewClick" />
            <Button Content="Löschen" Name="DeleteButton" Click="OnDeleteClick" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Name="Editor" Spacing="10">
          <StackPanel Spacing="3">
            <TextBlock Text="Name" Foreground="#AAAAAA" FontSize="12" />
            <TextBox Name="NameBox" PlaceholderText="z. B. 5424 IT-Basis-Dienste" />
          </StackPanel>
          <StackPanel Spacing="3">
            <TextBlock Text="Beschreibung" Foreground="#AAAAAA" FontSize="12" />
            <TextBox Name="DescriptionBox" PlaceholderText="optional"
                     AcceptsReturn="True" Height="90" TextWrapping="Wrap" />
          </StackPanel>
          <Button Content="Übernehmen" Click="OnApplyClick" Background="#123E6B"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="16" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Name="StatusText" VerticalAlignment="Center"
                   Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" />
        <Button Grid.Column="1" Content="Schließen" Click="OnCloseClick" IsCancel="True" />
      </Grid>
    </Grid>
  </Border>
</controls:ChromeWindow>
