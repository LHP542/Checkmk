<controls:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Checkmk.App.Controls"
        xmlns:vm="using:Checkmk.App.ViewModels"
        x:Class="Checkmk.App.Views.FilterManagerWindow"
        x:DataType="vm:FilterManagerViewModel"
        Width="780" Height="560"
        Title="Host-Filter verwalten"
        WindowStartupLocation="CenterOwner">

  <Border BorderBrush="#3A3A3A" BorderThickness="1" Background="#1E1E1E">
    <Grid RowDefinitions="40,*,Auto">

      <controls:TitleBar Grid.Row="0" Title="Host-Filter verwalten" />

      <Grid Grid.Row="1" ColumnDefinitions="260,*" Margin="12" ColumnSpacing="12">

        <!-- Filter-Liste links: die eigenen plus die abonnierten. Die Marke ist
             keine Zierde — einem veröffentlichten Filter sieht man sonst nicht
             an, dass eine Änderung daran alle Abonnenten trifft. -->
        <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto" RowSpacing="6">
          <ListBox Grid.Row="0" ItemsSource="{Binding Filters}"
                   SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                  <TextBlock Grid.Column="0" Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Background="#2A3F55" CornerRadius="3"
                          Padding="5,1" Margin="6,0,0,0"
                          IsVisible="{Binding IsPublished}">
                    <TextBlock Text="{Binding FachbereichName}" FontSize="11" Foreground="#9CC4E4" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <!-- WrapPanel statt StackPanel: Vier Knöpfe passen nicht nebeneinander
               in die Listenspalte, und „Fachbereiche…" lief vorher aus der
               Spalte heraus über den Editor. Umbrechen statt abschneiden —
               und es hält, wenn eine Beschriftung länger wird. -->
          <WrapPanel Grid.Row="1" Orientation="Horizontal"
                     ItemSpacing="6" LineSpacing="6">
            <Button Content="Neu" Command="{Binding NewCommand}"
                    IsEnabled="{Binding CanEdit}" />
            <!-- Beschriftung wechselt: bei einem Katalog-Filter nimmt der Knopf
                 ihn nur aus meiner Auswahl, gelöscht wird da nichts. -->
            <Button Content="{Binding RemoveLabel}" Command="{Binding DeleteCommand}"
                    IsEnabled="{Binding CanDeleteSelected}"
                    ToolTip.Tip="{Binding RemoveTip}" />
            <Button Content="Katalog…" Click="OnCatalogClick"
                    IsVisible="{Binding IsCentral}"
                    ToolTip.Tip="Filter der Fachbereiche durchsehen und abonnieren." />
            <Button Content="Fachbereiche…" Click="OnManageFachbereicheClick"
                    IsVisible="{Binding IsAdmin}"
                    ToolTip.Tip="Fachbereiche anlegen, umbenennen, löschen." />
          </WrapPanel>

          <TextBlock Grid.Row="2" Text="{Binding SelectionHint}" FontSize="11"
                     Foreground="#AAAAAA" TextWrapping="Wrap"
                     IsVisible="{Binding SelectionHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>

        <!-- Editor rechts -->
        <StackPanel Grid.Column="1" Spacing="10"
                    IsEnabled="{Binding CanEditSelected}">
          <StackPanel Spacing="3">
            <TextBlock Text="Name" Foreground="#AAAAAA" FontSize="12" />
            <TextBox Text="{Binding EditName}" PlaceholderText="z. B. DB-Server" />
          </StackPanel>

          <!-- Der eigentliche Punkt an Punkt 26: Ein Filter, der dem Team
               gehört, steht der Urlaubsvertretung ohne Zutun zur Verfügung. -->
          <StackPanel Spacing="3" IsVisible="{Binding IsCentral}">
            <TextBlock Text="Veröffentlicht in" Foreground="#AAAAAA" FontSize="12" />
            <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding EditScope}"
                      HorizontalAlignment="Stretch"
                      DisplayMemberBinding="{Binding Label}"
                      ToolTip.Tip="„nur für mich“ bleibt privat. In einen Fachbereich veröffentlicht steht der Filter im Katalog, und jeder kann ihn abonnieren." />
          </StackPanel>
          <!-- Der Regex geht wahlweise auf den Hostnamen oder den Alias. Zwei
               RadioButtons statt einer ComboBox: die Alternative soll sichtbar
               sein, nicht hinter einem Klick liegen. Betrifft nur den Regex —
               die Liste darunter bleibt eine Liste von Hostnamen. -->
          <StackPanel Spacing="3">
            <TextBlock Text="Regex vergleichen mit" Foreground="#AAAAAA" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <RadioButton GroupName="MatchTarget" Content="Hostname"
                           IsChecked="{Binding !EditMatchesAlias}" />
              <RadioButton GroupName="MatchTarget" Content="Alias"
                           IsChecked="{Binding EditMatchesAlias}"
                           ToolTip.Tip="Der Alias trägt bei uns die zugeordneten Benutzer — ein Filter auf den eigenen Anmeldenamen liefert „alle meine Rechner“." />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding RegexLabel}"
                       Foreground="#AAAAAA" FontSize="12" />
            <TextBox Text="{Binding EditRegex}" PlaceholderText="{Binding RegexPlaceholder}" />
            <TextBlock Text="{Binding ValidationMessage}" Foreground="#EF5350" FontSize="12"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <StackPanel Spacing="3">
            <TextBlock Text="Explizite Hostnamen (eine je Zeile — wenn gesetzt, überschreibt das Regex)"
                       Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" />
            <TextBox Text="{Binding EditExplicitHosts}"
                     AcceptsReturn="True" Height="140" TextWrapping="NoWrap"
                     FontFamily="Consolas,Courier New,monospace" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Übernehmen" Command="{Binding ApplyCommand}" Background="#123E6B" />
            <Button Content="Aktivieren" Command="{Binding ActivateSelectedCommand}" />
            <Button Content="Filter deaktivieren" Command="{Binding ClearActiveCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="16" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                   Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" />
        <Button Grid.Column="1" Content="Schließen" Click="OnDismissClick" />
      </Grid>
    </Grid>
  </Border>
</controls:ChromeWindow>
