<controls:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Checkmk.App.Controls"
        x:Class="Checkmk.App.Views.HostPatternDialog"
        Width="600" Height="640"
        Title="Host-Zuordnung"
        WindowStartupLocation="CenterOwner">

  <Border BorderBrush="#3A3A3A" BorderThickness="1" Background="#1E1E1E">
    <Grid RowDefinitions="40,Auto,Auto,*,Auto">

      <controls:TitleBar Grid.Row="0" Name="DialogTitleBar" Title="Host-Zuordnung" />

      <StackPanel Grid.Row="1" Margin="16,12,16,0" Spacing="4">
        <TextBlock Name="PromptText" TextWrapping="Wrap" FontWeight="SemiBold" />

        <!-- Weg 1: der gepflegte Checkmk-Tag. Steht oben, weil er das
             staerkere Signal ist und in den meisten Faellen genuegt. -->
        <TextBlock Text="Checkmk-Ortstag" Margin="0,10,0,0" FontWeight="SemiBold" />
        <TextBlock Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                   Text="Im Setup gepflegt und deshalb verlässlicher als der Hostname. Trifft auch Geräte, die aus der Namenskonvention fallen." />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <ComboBox Grid.Column="0" Name="TagBox" HorizontalAlignment="Stretch"
                    PlaceholderText="— kein Tag —" />
          <Button Grid.Column="1" Name="TagClearButton" Content="Kein Tag"
                  Click="OnTagClearClick" ToolTip.Tip="Tag-Bindung dieses Bereichs lösen" />
        </Grid>
        <TextBlock Name="TagStateText" FontSize="12" TextWrapping="Wrap" />

        <!-- Weg 2: der Regex. Bleibt, weil die Site LHP kaum Ortstags fuehrt. -->
        <TextBlock Text="Hostname-Muster" Margin="0,12,0,0" FontWeight="SemiBold" />
        <TextBlock Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                   Text="Greift nur bei Hosts ohne passenden Tag. Regulärer Ausdruck, Groß-/Kleinschreibung egal: (?&lt;!\d)46(?!\d) trifft 46-SW04, NAS46-01 und iRMC-46, aber nicht 146-SW01." />
        <TextBox Name="PatternBox" PlaceholderText="z. B. (?&lt;!\d)46(?!\d) oder stadthaus" />
        <TextBlock Name="StateText" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>

      <TextBlock Grid.Row="2" Name="MatchHeader" Text="Treffer:"
                 Margin="16,10,16,4" FontWeight="SemiBold" />

      <ListBox Grid.Row="3" Name="MatchList" Margin="16,0,16,0" />

      <!-- „Speichern" merkt nur die Regel. Dass danach noch „Zuordnung
           vorschlagen…" kommt, sieht man dem Dialog nicht an — er heißt
           „Host-Zuordnung" und zeigt die Treffer. Deshalb der zweite Knopf,
           der beides hintereinander macht. Die Bestätigung bleibt: Er
           überspringt nur das Suchen des zweiten Schritts.
           WrapPanel, weil vier Knöpfe mit diesen Beschriftungen nicht in jede
           Fensterbreite passen. -->
      <WrapPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                 Margin="16" ItemSpacing="8" LineSpacing="8">
        <Button Content="Muster entfernen" Click="OnClearClick" />
        <Button Content="Speichern" Click="OnOkClick" />
        <Button Content="Speichern und zuordnen" Click="OnOkAndAssignClick"
                Background="#123E6B" IsDefault="True"
                ToolTip.Tip="Merkt die Regel und zeigt sofort die Zuordnungsvorschläge für diesen Bereich — übernommen wird erst nach deiner Bestätigung." />
        <Button Content="Abbrechen" Click="OnCancelClick" IsCancel="True" />
      </WrapPanel>
    </Grid>
  </Border>
</controls:ChromeWindow>
