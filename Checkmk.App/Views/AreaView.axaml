<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Checkmk.App.ViewModels"
             xmlns:controls="using:Checkmk.App.Controls"
             x:Class="Checkmk.App.Views.AreaView"
             x:DataType="vm:AreaViewModel">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Toolbar -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8"
          Margin="4,4,4,8">
      <Button Grid.Column="0" Content="Neuer Bereich…" Click="OnNewAreaClick"
              IsVisible="{Binding CanWrite}" IsEnabled="{Binding !IsBusy}" />
      <Button Grid.Column="1" Content="Unterbereich…" Click="OnNewChildAreaClick"
              IsVisible="{Binding CanWrite}"
              IsEnabled="{Binding CanEditSelection}"
              ToolTip.Tip="Legt einen Bereich unterhalb des markierten an." />
      <Button Grid.Column="2" Content="Umbenennen…" Click="OnRenameClick"
              IsVisible="{Binding CanWrite}"
              IsEnabled="{Binding CanEditSelection}" />
      <Button Grid.Column="3" Content="Löschen" Click="OnDeleteClick"
              IsVisible="{Binding CanWrite}"
              IsEnabled="{Binding CanEditSelection}"
              ToolTip.Tip="Geht nur, wenn der Bereich keine Unterbereiche und keine Hosts mehr hat." />
      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
        <Button Name="DrawButton" Content="Fläche zeichnen" Click="OnDrawAreaClick"
                IsVisible="{Binding CanWrite}"
                IsEnabled="{Binding CanEditSelection}"
                ToolTip.Tip="Klicken setzt Punkte, Doppelklick oder Enter schließt die Fläche, Esc bricht ab, Rücktaste nimmt den letzten Punkt zurück." />
        <Button Name="EditButton" Content="Fläche bearbeiten" Click="OnEditAreaClick"
                IsVisible="False"
                ToolTip.Tip="Punkte ziehen, Kantenmitte klicken fügt eine Ecke ein, Rechtsklick oder Entf entfernt eine. Enter übernimmt, Esc verwirft." />
        <Button Content="Standorte übernehmen…" Click="OnImportPlacesClick"
                IsVisible="{Binding CanWrite}" IsEnabled="{Binding !IsBusy}"
                ToolTip.Tip="Holt Standortlisten der Landeshauptstadt vom Kartenserver und legt die ausgewählten als Bereiche an." />
        <Button Content="Tags zuordnen…" Click="OnMatchTagsClick"
                IsVisible="{Binding CanWrite}" IsEnabled="{Binding !IsBusy}"
                ToolTip.Tip="Gleicht die Checkmk-Ortstags (tag_location_school) über die Standortnummer gegen die Bereiche ab. Einmal durchsehen, danach ordnen die Tags die Hosts von selbst zu." />
        <Button Content="Zuordnung vorschlagen…" Click="OnSuggestClick"
                IsVisible="{Binding CanWrite}" IsEnabled="{Binding !IsBusy}"
                ToolTip.Tip="Sucht anhand von Ortstag und Host-Muster, welche Hosts zu welchem Bereich gehören — zum Durchsehen und Bestätigen." />
        <Button Name="PrefetchButton" Content="Karten vorladen" Click="OnPrefetchClick"
                ToolTip.Tip="Lädt die Kacheln rund um alle Standorte im Hintergrund. Danach ist die Karte sofort da — auch ohne Internet." />
      </StackPanel>
      <TextBlock Grid.Column="5" Text="Karte:" VerticalAlignment="Center" Foreground="#AAAAAA" />
      <ComboBox Grid.Column="6" Name="LayerBox" MinWidth="160" VerticalAlignment="Center"
                ToolTip.Tip="Kartenhintergrund. Auf dem Luftbild sind eingefärbte Flächen schwerer zu lesen — der Stadtplan hat Straßennamen, die Graustufenkarte lässt die Ampel am deutlichsten hervortreten." />
      <Button Grid.Column="7" Content="Neu laden" Command="{Binding ReloadCommand}"
              IsEnabled="{Binding !IsBusy}" />
    </Grid>

    <!-- Baum links, Karte rechts. Auswahl ist in beiden Richtungen verbunden:
         Klick im Baum springt auf die Fläche, Klick auf die Fläche markiert
         den Knoten. -->
    <Grid Grid.Row="1" Name="SplitGrid" ColumnDefinitions="320,4,*">

    <TreeView Grid.Column="0" ItemsSource="{Binding Roots}"
              SelectedItem="{Binding SelectedTreeItem}">
      <TreeView.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Hosts zuweisen…" Click="OnAssignHostsClick"
                    IsVisible="{Binding CanWrite}" />
          <MenuItem Header="Technik verschieben nach…" Click="OnMoveHostsClick"
                    IsVisible="{Binding CanWrite}"
                    ToolTip.Tip="Verschiebt alle Hosts dieses Bereichs in einen anderen — etwa wenn ein Haus aufgelöst wird." />
          <MenuItem Header="Sichtbar in Sites…" Click="OnEditSitesClick"
                    IsVisible="{Binding CanWrite}"
                    ToolTip.Tip="Legt fest, in welchen Checkmk-Sites dieser Bereich erscheint. Nichts angehakt = überall." />
          <MenuItem Header="Host-Zuordnung…" Click="OnEditPatternClick"
                    IsVisible="{Binding CanWrite}"
                    ToolTip.Tip="Woher dieser Bereich seine Hosts bekommt: Checkmk-Ortstag oder Namensmuster. Bei Schulen aus der Schulnummer vorbelegt." />
          <Separator IsVisible="{Binding CanWrite}" />
          <MenuItem Header="Unterbereich…" Click="OnNewChildAreaClick"
                    IsVisible="{Binding CanWrite}" />
          <MenuItem Header="Umbenennen…" Click="OnRenameClick"
                    IsVisible="{Binding CanWrite}" />
          <MenuItem Header="Löschen" Click="OnDeleteClick"
                    IsVisible="{Binding CanWrite}" />
        </ContextMenu>
      </TreeView.ContextMenu>
      <TreeView.DataTemplates>
        <!-- Unterbereiche UND zugeordnete Hosts haengen unter demselben Knoten;
             der TreeView kann nur eine Kindliste binden. -->
        <TreeDataTemplate DataType="vm:AreaNodeViewModel" ItemsSource="{Binding TreeChildren}">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <!-- Grauer Punkt bei leeren Bereichen: „keine Hosts" ist nicht
                 dasselbe wie „alles in Ordnung". -->
            <Border Width="12" Height="12" CornerRadius="6" VerticalAlignment="Center"
                    Background="{Binding WorstState, Converter={StaticResource StateToBrush}}"
                    IsVisible="{Binding !IsEmptyOfHosts}" />
            <Border Width="12" Height="12" CornerRadius="6" VerticalAlignment="Center"
                    Background="#555555" IsVisible="{Binding IsEmptyOfHosts}"
                    ToolTip.Tip="Diesem Bereich sind (im aktiven Filter) keine Hosts zugeordnet." />
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Badge}" Foreground="#AAAAAA" VerticalAlignment="Center" />
            <!-- „(3 zugeordnet)" nur, wenn der Filter weniger durchlaesst als
                 zugeordnet ist — sonst waere es Rauschen. -->
            <TextBlock Text="{Binding AssignedNote}" Foreground="#8FA8C0" FontSize="11"
                       VerticalAlignment="Center"
                       ToolTip.Tip="So viele Geräte sind diesem Bereich zugeordnet. Aufklappen zeigt sie — auch die, die der aktive Filter ausblendet." />
          </StackPanel>
        </TreeDataTemplate>

        <!-- Ein zugeordneter Host. Blass, wenn der aktive Filter ihn ausblendet:
             er gehoert hierher, zaehlt aber nicht in die Ampel des Bereichs. -->
        <DataTemplate DataType="vm:AreaHostViewModel">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Width="9" Height="9" CornerRadius="5" VerticalAlignment="Center"
                    Background="{Binding State, Converter={StaticResource StateToBrush}}"
                    IsVisible="{Binding InFilter}" />
            <Border Width="9" Height="9" CornerRadius="5" VerticalAlignment="Center"
                    Background="#444444" IsVisible="{Binding !InFilter}" />
            <TextBlock Text="{Binding HostName}" VerticalAlignment="Center"
                       Foreground="#DDDDDD" IsVisible="{Binding InFilter}" />
            <TextBlock Text="{Binding HostName}" VerticalAlignment="Center"
                       Foreground="#777777" IsVisible="{Binding !InFilter}" />
            <TextBlock Text="{Binding Note}" Foreground="#777777" FontSize="11"
                       VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </TreeView.DataTemplates>
    </TreeView>

      <GridSplitter Grid.Column="1" Background="#333333" ResizeDirection="Columns" />

      <Border Grid.Column="2" BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid>
          <controls:MapCanvas Name="Map" />

          <!-- Dasselbe Menü wie am Baum. Der Weg „Fläche sehen → im Baum
               suchen → Rechtsklick" war der Umweg bei jedem Zuordnen. -->
          <Grid.ContextMenu>
            <ContextMenu Name="MapMenu">
              <MenuItem Header="Hosts zuweisen…" Click="OnAssignHostsClick" />
              <MenuItem Header="Technik verschieben nach…" Click="OnMoveHostsClick" />
              <MenuItem Header="Host-Zuordnung…" Click="OnEditPatternClick" />
              <Separator />
              <MenuItem Header="Fläche bearbeiten" Click="OnEditAreaClick" />
              <MenuItem Header="Kartenhintergrund…" Click="OnAreaLayerClick"
                        ToolTip.Tip="Eigener Hintergrund für diesen Bereich — etwa ein Gebäudeplan auf der Campus-Ebene." />
              <Separator />
              <MenuItem Header="Sichtbar in Sites…" Click="OnEditSitesClick" />
              <MenuItem Header="Umbenennen…" Click="OnRenameClick" />
            </ContextMenu>
          </Grid.ContextMenu>

          <!-- Hinweisleiste im Zeichenmodus: die Tastenkürzel stehen sonst nur
               im ToolTip des Buttons, den man beim Zeichnen nicht mehr sieht. -->
          <Border Name="DrawHint" IsVisible="False" VerticalAlignment="Top"
                  HorizontalAlignment="Center" Margin="0,10,0,0"
                  Background="#CC123E6B" CornerRadius="4" Padding="12,5">
            <TextBlock Text="Punkte klicken · Doppelklick oder Enter schließt · Rücktaste nimmt zurück · Esc bricht ab"
                       FontSize="12" />
          </Border>
          <Border Name="EditHint" IsVisible="False" VerticalAlignment="Top"
                  HorizontalAlignment="Center" Margin="0,10,0,0"
                  Background="#CC1B5E20" CornerRadius="4" Padding="12,5">
            <TextBlock Text="Punkte ziehen · Kantenmitte klicken fügt ein · Rechtsklick oder Entf entfernt · Enter übernimmt · Esc verwirft"
                       FontSize="12" />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="4,8,4,4"
               FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap" />
  </Grid>
</UserControl>
