<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Transitives Pinning: JEDE transitive Abhaengigkeit wird auf die hier
      angegebene Version gehoben, statt dass NuGet die niedrigste passende
      auswaehlt.

      In diesem Netz ist das nicht Kosmetik, sondern Voraussetzung: Der Proxy
      liefert .nupkg von nuget.org mit 403 aus, Pakete kommen aus dem
      Offline-Bundle C:\NuGet-Local. Ohne Pinning verlangt der Graph munter
      Microsoft.Extensions.* in 9.0.11, 10.0.0 und 10.0.8 nebeneinander — jede
      dieser Versionen muesste einzeln von Hand beschafft werden, obwohl 10.0.11
      laengst dort liegt. Mit Pinning gibt es genau eine Version je Paket.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core / DI / Logging -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.8" />

    <!-- Auf 10.0.11 gehoben, weil EF Core 10.0.11 mindestens das fordert.
         Alle folgenden Eintraege sind transitiv und stehen nur hier, damit das
         Pinning oben greift — nicht, weil ein Projekt sie direkt referenziert. -->
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Primitives" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.6" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.5" />
    <PackageVersion Include="NLog" Version="6.2.0" />
    <PackageVersion Include="NLog.Extensions.Logging" Version="6.2.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
    <!-- Transitiv von Avalonia.FreeDesktop (Linux/DBus). MUSS zur von Avalonia geforderten
         Version passen (12.1.0 -> 0.94.1), sonst MissingTypeException zur Laufzeit.
         GHSA-xrw6-gwf8-vvr9 betrifft nur < 0.20, dieser Pin ist damit nicht verwundbar. -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <!-- Windows-only: WinRT-Toast-Wrapper. Nur im net10.0-windows-TFM referenziert. -->
    <PackageVersion Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Kommt transitiv aus Microsoft.Toolkit.Uwp.Notifications 7.1.3 als 4.7.0 rein,
         Version hat GHSA-rxg9-xrhp-64gj (kritisch) -> auf .NET-10-Serie heben. -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.9" />
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <!-- Zentrale Konfiguration/Bereiche auf FOC-SQL01. Bewusst NUR das
         SqlServer-Paket: Microsoft.EntityFrameworkCore.Design (Migrationen) zoege
         Roslyn-Workspaces und MSBuild nach (~6 weitere Pakete), und das Schema
         pflegen wir per SQL-Skript in db/ — Migrationen fahren ohnehin nur
         Administratoren mit dem SA-Konto. Siehe db/README.md. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />

    <!-- MVVM / UI -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- DataGrid und DiagnosticsSupport folgen einer eigenen Versionskadenz -->
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FluentAssertions" Version="[7.2.2,8.0.0)" />
  </ItemGroup>

</Project>
